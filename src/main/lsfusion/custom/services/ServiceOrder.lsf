MODULE ServiceOrder;

REQUIRE Doc, MetaNumerator, Input, DateUtils, FileUtils, Comments,
BomNested, LocationEmployee,
ServiceOrderType, ServicesSettings;

NAMESPACE Services;

CLASS Order 'Service order';

@defineDocStatus(order, 'Service order status');

type 'Type' = DATA OrderType (Order) NONULL;
nameType 'Type' (Order o) = name(type(o)) CHARWIDTH 15;

WHEN LOCAL SET(Order o IS Order) AND NOT CHANGED(type(o)) DO type(o) <- defaultOrderType();

scheduledDateTime 'Start date' = DATA DATETIME (Order) IN id;
scheduledDateTime(Order o) <- currentDateTime() WHEN SET(o IS Order);
@defineDateTimeAggregation(Order, scheduled, '(scheduled)');

@defineNumberType(Order);

numberDate 'Description' (Order o) = number(o) + ' (' + scheduledDateTime(o) + ')' IN id;

item '{Item}' = DATA Item (Order);
nameItem '{Item}' (Order m) = name(item(m));

uom (Order o) = uom(item(o));
nameUom 'UoM' (Order m) = name(uom(m));

responsible = DATA Employee (Order);
nameResponsible 'Responsible' (Order o) = MasterData.name(responsible(o));

responsible(Order o) <- currentUser() IF currentUser() IS Employee WHEN SET(o IS Order);

// bom
//bom 'Bill of Materials' = DATA Bom (ServiceOrder);
//descriptionBom 'Bill of Materials' (ServiceOrder m) = description(bom(m));
//CONSTRAINT bom(ServiceOrder m) AND NOT item(m) = item(bom(m))
//    CHECKED BY bom[ServiceOrder]
//    MESSAGE 'Service order BOM item must be equal to production order item';
//
//WHEN LOCAL CHANGED(item(ServiceOrder o)) AND NOT CHANGED(bom(o)) AND defaultBom(item(o)) DO
//    bom(o) <- defaultBom(item(o));

company = DATA Company (Order);
nameCompany 'Company' (Order m) = name(company(m));
WHEN LOCAL SET(Order o IS Order) AND NOT CHANGED(company(o)) DO company(o) <- defaultCompany();

materialsLocation 'Materials location' = DATA Location (Order);
nameMaterialsLocation 'Materials location' (Order m) = name(materialsLocation(m));
WHEN LOCAL SETCHANGED(type(Order mo)) AND NOT materialsLocation(mo) DO materialsLocation(mo) <- materialsLocation(type(mo));
CONSTRAINT SETCHANGED(materialsLocation(Order o)) AND internalUse(materialsLocation(o)) CHECKED BY materialsLocation[Order]
    MESSAGE 'The selected location is for internal use';

//unbuild 'Unbuild' (ServiceOrder mo)= unbuild(type(mo));

note 'Note' = DATA ISTRING (Order) CHARWIDTH 20;

// consumed
CLASS ConsumedLine 'Materials';

order = DATA Order (ConsumedLine) NONULL DELETE;

countConsumedLine 'Material lines' (Order m) = GROUP SUM 1 IF order(ConsumedLine l) = m MATERIALIZED;
index '№' = PARTITION SUM 1 ORDER ConsumedLine l BY order(l) IN id MATERIALIZED CHARWIDTH 3;

item '{Item}' = DATA Item (ConsumedLine);
nameItem '{Item}' (ConsumedLine l) = name(item(l));
idBarCodeItem 'Barcode' (ConsumedLine l) = idBarCode(item(l));
idItem '{ID}' (ConsumedLine l) = id(item(l));

description 'Description' = DATA ISTRING (ConsumedLine);

uom (ConsumedLine l) = uom(item(l));
nameUom 'UoM' (ConsumedLine l) = name(uom(l));

toConsume 'To consume' = DATA NUMERIC[16,3] (ConsumedLine);

toConsume 'To consume' (Order o) = GROUP SUM toConsume(ConsumedLine l) IF order(l) = o AND item(l) = item(o) MATERIALIZED;

//// finished
//CLASS FinishedLine 'Finished products';
//
//serviceOrder = DATA ServiceOrder (FinishedLine) NONULL DELETE;
//
//countFinishedLine 'Product lines' (ServiceOrder m) = GROUP SUM 1 IF serviceOrder(ConsumedLine l) = m MATERIALIZED;
//index '№' = PARTITION SUM 1 ORDER FinishedLine l BY serviceOrder(l) IN id MATERIALIZED CHARWIDTH 3;
//
